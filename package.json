{
  "name": "jb-cv-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev:web": "pnpm --filter jb-cv-fe dev",
    "dev:studio": "pnpm --filter jb-cv-studio dev",
    "build:web": "pnpm --filter jb-cv-fe build",
    "start:web": "pnpm --filter jb-cv-fe start",
    "typegen:studio": "pnpm --filter jb-cv-studio typegen",
    "build:studio": "pnpm --filter jb-cv-studio build",
    "deploy:studio": "pnpm --filter jb-cv-studio deploy"
  }
}